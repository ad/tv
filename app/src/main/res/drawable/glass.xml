<?xml version="1.0" encoding="utf-8"?>
<!-- Sheen as a gradient stop, not a layer, so it survives the shortest panel; corners stay near-concentric with the tiles. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="18dp" />
    <gradient
        android:angle="270"
        android:centerColor="#1AFFFFFF"
        android:centerY="0.4"
        android:endColor="#12FFFFFF"
        android:startColor="#3DFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
</shape>
