<?xml version="1.0" encoding="utf-8"?>
<!-- "Liquid glass" without real blur: translucent fill, light rim and a soft top highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:endColor="#1AFFFFFF"
                android:startColor="#38FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="60dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape>
            <corners
                android:topLeftRadius="25dp"
                android:topRightRadius="25dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
